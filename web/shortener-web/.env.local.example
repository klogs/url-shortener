# Copy to .env.local — never commit .env.local

# Backend API base URL (server-side routes use this internally)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Cloudflare Turnstile site key (public — safe to expose)
# Use the test key for local development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_CAPTCHA_SITE_KEY=1x00000000000000000000AA

# OIDC (server-side only — never NEXT_PUBLIC_)
AUTH_AUTHORITY=https://idp.klogs.io
AUTH_CLIENT_ID=klogs.web
AUTH_CLIENT_SECRET=change_me
