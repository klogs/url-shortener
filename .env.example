# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me

# ─── RabbitMQ (Phase 2) ────────────────────────────────────────────────────────
RABBITMQ_PASSWORD=change_me

# ─── Authentication (OIDC) ────────────────────────────────────────────────────
# Klogs deployment: AUTH__ISSUER=https://idp.klogs.io
AUTH_ISSUER=https://your-idp.example.com
AUTH__CLIENT_ID=your-client-id
AUTH__CLIENT_SECRET=change_me
AUTH__SCOPES=openid profile email

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────────────
# Use Provider=Disabled for local development.
CAPTCHA__PROVIDER=Disabled
CAPTCHA__SITE_KEY=
CAPTCHA__SECRET_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
APP__DEFAULT_DOMAIN=localhost:8080

# ─── Analytics Retention ──────────────────────────────────────────────────────
ANALYTICS__RAW_RETENTION_DAYS=90

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT__PUBLIC_CREATE_PER_MINUTE=5
RATE_LIMIT__PUBLIC_CREATE_PER_HOUR=30

# ─── Anonymous Links ──────────────────────────────────────────────────────────
ANONYMOUS__EXPIRATION_DAYS=7

# ─── Multi-tenancy ────────────────────────────────────────────────────────────
# SingleTenant or MultiTenant
MULTITENANCY__MODE=SingleTenant

# Backend API base URL — used by the server-side proxy route handler (app/api/v1/[...path])
# Local dev: use HTTP port to avoid .NET dev-cert issues (check launchSettings.json for the http port)
BACKEND_API_URL=http://localhost:5009

# Cloudflare Turnstile site key (public — safe to expose)
# Use the test key for local development:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_CAPTCHA_SITE_KEY=1x00000000000000000000AA

# Copy to .env.local — never commit .env.local
